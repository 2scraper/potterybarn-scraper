# potterybarn-scraper — configuration
# ===================================
# Copy to `.env` and fill in. `.env` is gitignored; this file is NOT, so it
# must never hold a real value. env_config.py reads exactly the four names
# below and warns about anything else.
#
# Credentials live HERE and nowhere else — never on a command line. `ps` reads
# argv, and argv lands in shell history and in CI logs. And never copy `.env`
# to another filename inside the repo: `.env.bak` is how a sibling repo
# published three live credentials.
#
# THE LISTING NEEDS NONE OF THESE. api_scraper.py --group-id sofa answers from
# anywhere with no key, no proxy and no browser (measured 2026-09-24), and so
# does catalog_walk.py.

# 2captcha.com API key. Used by the captcha solver fallback (never needed on
# this site so far), fingerprint_client.py and tools/browser_profile_client.py.
TWOCAPTCHA_KEY=

# An HTTP proxy, as a single URL: http://user:pass@host:port
#
# Needed for PRODUCT PAGES, and it must be a US exit. Measured 2026-09-23/24:
# a non-US address gets the branded 403 (or, on /robots.txt, a redirect to
# potterybarn.co.uk), and a GB exit is refused on every page. A 2Captcha
# gateway login with `-region-us` works; http_scraper.py mints a fresh
# session-pinned exit whenever a page is refused or redirected.
POTTERYBARN_PROXY=

# A Scraping Browser API CDP endpoint, for the browser engines only:
#
#   ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222
#
# A profile allows ONE live connection. Do not "check" it with
# GET /json/version — that call takes the lock itself. See README for what the
# browser path was measured to do on this site before relying on it.
POTTERYBARN_CDP_ENDPOINT=

# Optional. The URL a browser engine fetches when --url is not given.
POTTERYBARN_URL=
