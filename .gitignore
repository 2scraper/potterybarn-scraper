# Everything below is GENERATED by running this project, or is a secret.

# --- never, under any circumstances ------------------------------------------
# `.env` as an exact name is NOT enough: on 2026-09-22 a sibling repo
# committed `.env.user-endpoint.bak` holding three live credentials, because
# the old rule matched only the exact name. The suite asserts these lines.
.env
.env.*
!.env.example
*.bak
*.orig
*.save
*.key
*.pem
secrets*
credentials*
*.log
# A downloaded 2Captcha proxy list: every line carries a login and password.
proxylist*.txt

# --- scrape output -------------------------------------------------------------
*.json
*.csv
!sample_output.json
!sample_output.csv
!sample_output.meta.json
!sample_skus.json
!sample_skus.meta.json
!fixtures/*.json
potterybarn_products.*
potterybarn_skus.*
canary_run.*
live/
# Run output by KIND of directory, not by one chosen name, and a dump named
# after its page (`--dump-html x.json` on page 3 writes x_p3.json; other
# tools in this space write x.page3).
out/
output/
runs/
results/
tmp/
scratch/
dumps/
*.page[0-9]*

# --- debug artefacts ------------------------------------------------------------
*_debug.html
*_debug.png
*_p[0-9]*.html
# A raw page saved at the repo root. Fixtures live under fixtures/.
/*.html

# --- caches, builds, environments ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.fingerprint_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# --- editors / OS ---------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
