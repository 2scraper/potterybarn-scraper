# Everything below is GENERATED by running this project, or is a secret.

# --- never, under any circumstances ------------------------------------------
# `.env` as an exact name is NOT enough: on 2026-09-22 a sibling repo
# committed `.env.user-endpoint.bak` holding three live credentials, because
# the old rule matched only the exact name. The suite asserts these lines.
.env
.env.*
!.env.example
*.bak
*.orig
*.save
*.key
*.pem
secrets*
credentials*
*.log
# A downloaded 2Captcha proxy list: every line carries a login and password.
proxylist*.txt

# --- scrape output -------------------------------------------------------------
*.json
*.csv
!sample_output.json
!sample_output.csv
!sample_output.meta.json
!sample_skus.json
!sample_skus.meta.json
!fixtures/*.json
potterybarn_products.*
potterybarn_skus.*
canary_run.*
live/

# --- debug artefacts ------------------------------------------------------------
*_debug.html
*_debug.png
*_p[0-9]*.html

# --- caches, builds, environments ----------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.fingerprint_cache/
*.egg-info/
dist/
build/
.venv/
venv/
env/

# --- editors / OS ---------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
